# 复制本文件为 .env（或直接设为系统环境变量）。源码内不含任何密钥。
# 留空 = 走离线抽取模式，链路仍可跑通与评测。

# 通道选择：deepseek（项目默认，官方） | glm（仅测试，日日新）
LLM_CHANNEL=deepseek

# ---- 通道 1：DeepSeek 官方（项目默认）----
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ---- 通道 2：日日新 Token Plan · glm-5.2（仅测试）----
SENSENOVA_API_KEY=
# GLM_BASE_URL=https://token.sensenova.cn/v1
# GLM_MODEL=glm-5.2

# 通用 Key 兜底（任一通道可用；优先级最高）
# LLM_API_KEY=

# 可选调参
MAX_INPUT_CHARS=500
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
WALL_CLOCK_BUDGET_S=60

# ---------- 应用 profile ----------
# finance = 金融合规护栏（拒绝荐股/收益承诺）；generic = 通用文档问答（只保留注入/隐私护栏）
# APP_PROFILE=finance

# ---------- 检索 ----------
# bm25 = 纯词法（默认，实测在本语料最优）；hybrid = BM25 + 哈希向量 + RRF + 重排
# RETRIEVAL=bm25
TOP_K=4

# ---------- 查询扩展 ----------
# off 关闭 / auto 有 Key 才用 / llm 强制用；扩展失败自动回退原问题
# QUERY_EXPANSION=auto

# ---------- PDF 解析 ----------
# auto = 有 pypdf 就用、没有就用内置解析（默认）；builtin = 强制纯标准库；pypdf = 强制用 pypdf
# PDF_ENGINE=auto
