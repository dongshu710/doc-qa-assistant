# 复制本文件为 .env（或直接设为系统环境变量）。源码内不含任何密钥。
# 留空 = 走离线抽取模式，检索、引用、评测链路仍可跑通。

# ---------- 模型端点（任意 OpenAI 兼容服务）----------
# 默认 DeepSeek 官方；换服务商只改这两个变量，不改代码。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 密钥：LLM_API_KEY 优先，兼容 DEEPSEEK_API_KEY
LLM_API_KEY=
# DEEPSEEK_API_KEY=

# ---------- 可选调参 ----------
MAX_INPUT_CHARS=500
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
WALL_CLOCK_BUDGET_S=60
TOP_K=4

# ---------- 应用 profile ----------
# finance = 金融合规护栏（拒绝荐股/收益承诺）；generic = 通用文档问答（只保留注入/隐私护栏）
# APP_PROFILE=finance

# ---------- 检索 ----------
# vector = 字符 n-gram 向量召回 + 重排（默认，零依赖）
# embedding = 真 embedding 召回（需配置下面一段）；bm25 / hybrid = 对照与降级
# RETRIEVAL=vector

# ---------- 真 embedding（OpenAI 兼容 /embeddings；bge 同协议）----------
# 先起 TEI / Xinference / vLLM / Ollama 端点，再把 BASE_URL 指过去。
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=http://127.0.0.1:8080/v1
# EMBEDDING_MODEL=BAAI/bge-m3
# 0 = 构建时探测维度；已知维度时填写可提前校验（不一致会直接报错）
# EMBEDDING_DIM=0
# EMBEDDING_BATCH=16
# EMBEDDING_TIMEOUT_S=8
# EMBEDDING_MAX_RETRIES=2
# EMBEDDING_INDEX_DIR=data/index
# auto = 有 FAISS 用 FAISS，否则 NumPy，再否则纯 Python；也可强制 pure/numpy/faiss/faiss-ivf
# VECTOR_STORE=auto
# VECTOR_IVF_NLIST=64
# VECTOR_IVF_NPROBE=8

# ---------- 查询扩展 ----------
# off 关闭 / auto 有 Key 才用 / llm 强制用；扩展失败自动回退原问题
# QUERY_EXPANSION=auto

# ---------- 多实例共享状态（可选）----------
# 配置后限流 / 幂等 / 成本切到 Redis；不可用时自动回退进程内状态
# REDIS_URL=redis://:password@127.0.0.1:6379/0
# REDIS_TIMEOUT_S=1.5
# REDIS_PREFIX=rag

# ---------- 知识库版本与审批 ----------
# KB_STORE=on；off 退回单目录模式（仅测试/批处理）
# KB_DIR=data/kb
# KB_SEED_DIR=data/knowledge
# auto = 本机管理员直通、其他来源审批；on = 全部审批；off = 全部直通
# KB_APPROVAL=auto

# ---------- 日志与成本 ----------
# file / stdout / both；stdout 每行一个 JSON，供 Fluent Bit / Vector 采集
# LOG_SINK=file
# 每千 token 单价（按供应商当期价格页填写）；0 = 只统计 token，不算金额
# TOKEN_PRICE_PER_1K=0

# ---------- 生产防护 ----------
# 限流：按客户端 IP 的令牌桶
# RATE_LIMIT_RPS=5
# RATE_LIMIT_BURST=10
# 幂等：Idempotency-Key 的复用窗口（秒）
# IDEMPOTENCY_TTL_S=300
# 成本上限：每日 token 预算，超限后跳过模型调用、降级为抽取式
# DAILY_TOKEN_BUDGET=200000
# 灰度：按请求 key 稳定分流；模型名由 /api/admin/config 动态调整
# CANARY_PERCENT=0
# CANARY_MODEL=
# 管理接口令牌：设置后 /api/admin/* 需带 X-Admin-Token
# ADMIN_TOKEN=

# ---------- PDF 解析 ----------
# auto = 有 pypdf 就用、没有就用内置解析（默认）；builtin = 强制纯标准库；pypdf = 强制用 pypdf
# PDF_ENGINE=auto
