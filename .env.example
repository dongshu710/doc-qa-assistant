# 环境变量全量清单 —— 由 tools/gen_env_example.py 从代码生成，不要手改。
# 改完代码跑一遍该工具；CI 会校验本文件与代码一致（不一致就失败）。
#
# 优先级：设置面板（写入 appconfig.json）> 环境变量 > 代码默认值。
# 面板里显式清空的项不会回落到环境变量，否则用户清不干净。

# ===== 问答模型 =====
# 接哪家模型、怎么重试。改了要重启服务。
# LLM_API_KEY=
# LLM_BACKOFF_BASE_S=1.0
# LLM_BACKOFF_MAX_S=10.0
# LLM_BASE_URL=
# LLM_MAX_RETRIES=3
# LLM_MODEL=deepseek-chat
# LLM_STREAM_MAX_S=   # 见 src/generator.py:201
# LLM_TIMEOUT_S=30.0

# ===== 向量检索 =====
# embedding 服务与索引。留空即用本地 hash 向量（零依赖，不联网）。
# EMBEDDING_API_KEY=
# EMBEDDING_BACKOFF_BASE_S=0.5
# EMBEDDING_BACKOFF_MAX_S=4.0
# EMBEDDING_BASE_URL=
# EMBEDDING_BATCH=16
# EMBEDDING_BUILD_BUDGET_S=600.0
# EMBEDDING_DIM=0
# EMBEDDING_INDEX_DIR=data/index
# EMBEDDING_MAX_RETRIES=2
# EMBEDDING_MODEL=
# EMBEDDING_PROVIDER=none
# EMBEDDING_RECALL_K=48
# EMBEDDING_TIMEOUT_S=8.0
# EMBEDDING_WALL_CLOCK_S=30.0

# ===== 向量索引后端 =====
# auto 会优先 numpy/faiss，都没有就用纯 Python。
# VECTOR_IVF_NLIST=64
# VECTOR_IVF_NPROBE=8
# VECTOR_STORE=auto

# ===== 检索与阈值 =====
# HEDGE_SCORE=0.8
# MIN_SCORE=0.3
# QUERY_EXPANSION=
# RETRIEVAL=vector
# RRF_K=60
# TOP_K=4

# ===== 关键词直出 =====
# 命中关键词时直接给条款，不调模型。
# KEYWORD_GUARD=
# KEYWORD_INDEX=
# KEYWORD_LLM=
# KEYWORD_LLM_MAX_CHARS=
# KEYWORD_MODE=
# KEYWORD_MULTI_DOC=
# KEYWORD_TOP_N=

# ===== 分块 =====
# 切多长的块、相邻块重叠多少。overlap 默认 auto。
# CHUNK_MAX_CHARS=   # 见 src/chunking.py:144
# CHUNK_OVERLAP=   # 见 src/chunking.py:40

# ===== 引用与拒答 =====
# 引用支持率不达标时是否降级。
# CITATION_STRICT=False

# ===== 上下文 =====
# MAX_CONTEXT_CHARS=6000
# MAX_INPUT_CHARS=500
# WALL_CLOCK_BUDGET_S=60.0

# ===== 知识库 =====
# 版本审批、保留几个历史版本。
# KB_APPROVAL=auto
# KB_ASYNC_RELOAD=on
# KB_DIR=data/kb
# KB_KEEP_VERSIONS=30
# KB_SEED_DIR=data/knowledge
# KB_STORE=on

# ===== 鉴权 =====
# 额外放行的 Host，逗号分隔。
# ADMIN_TOKEN=
# ALLOWED_HOSTS=   # 见 src/security.py:51
# API_KEYS=

# ===== 多实例（可选） =====
# 不设则用进程内限流与计费；多实例部署才需要。
# REDIS_PREFIX=rag
# REDIS_TIMEOUT_S=1.5
# REDIS_URL=

# ===== 限流与成本 =====
# DAILY_TOKEN_BUDGET=
# IDEMPOTENCY_TTL_S=300
# RATE_LIMIT_BURST=10
# RATE_LIMIT_RPS=5.0
# TOKEN_PRICE_PER_1K=

# ===== 灰度 =====
# 按百分比把流量分给另一个模型。
# CANARY_MODEL=
# CANARY_PERCENT=0

# ===== 笔记 =====
# NOTES_CORS=   # 见 src/handlers/base.py:469
