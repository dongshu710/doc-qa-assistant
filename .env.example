# 复制本文件为 .env（或直接设为系统环境变量）。源码内不含任何密钥。
# 留空 = 走离线抽取模式，检索、引用、评测链路仍可跑通。

# ---------- 模型端点（任意 OpenAI 兼容服务）----------
# 默认 DeepSeek 官方；换服务商只改这两个变量，不改代码。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 密钥：LLM_API_KEY 优先，兼容 DEEPSEEK_API_KEY
LLM_API_KEY=
# DEEPSEEK_API_KEY=

# ---------- 可选调参 ----------
MAX_INPUT_CHARS=500
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
WALL_CLOCK_BUDGET_S=60
TOP_K=4

# ---------- 应用 profile ----------
# finance = 金融合规护栏（拒绝荐股/收益承诺）；generic = 通用文档问答（只保留注入/隐私护栏）
# APP_PROFILE=finance

# ---------- 检索 ----------
# vector = 字符 n-gram 向量召回 + 重排（默认，零依赖）
# embedding = 真 embedding 召回（需配置下面一段）；bm25 / hybrid = 对照与降级
# RETRIEVAL=vector

# ---------- 关键词直出（命中清单/标签条目时本地返回，不调用任何 API）----------
# on = 启用；off = 全部走检索
KEYWORD_MODE=on
# auto = 有 Key 才对新增/变更文档做摘要与同义词整理；off = 纯本地；on = 强制尝试
KEYWORD_LLM=auto
KEYWORD_TOP_N=3
KEYWORD_INDEX=data/index/keywords.json
KEYWORD_LLM_MAX_CHARS=2400
# on = 否定/极性、解释型意图、单文档收敛三道闸门生效；off = 回到 1.4.0 行为（A/B 用）
KEYWORD_GUARD=on
# off = 一次直出只取得分最高的一份文档；on = 允许跨文档拼接
KEYWORD_MULTI_DOC=off

# ---------- 真 embedding（OpenAI 兼容 /embeddings；bge 同协议）----------
# 先起 TEI / Xinference / vLLM / Ollama 端点，再把 BASE_URL 指过去。
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=http://127.0.0.1:8080/v1
# EMBEDDING_MODEL=BAAI/bge-m3
# 0 = 构建时探测维度；已知维度时填写可提前校验（不一致会直接报错）
# EMBEDDING_DIM=0
# EMBEDDING_BATCH=16
# EMBEDDING_TIMEOUT_S=8
# EMBEDDING_MAX_RETRIES=2
# EMBEDDING_INDEX_DIR=data/index
# auto = 有 FAISS 用 FAISS，否则 NumPy，再否则纯 Python；也可强制 pure/numpy/faiss/faiss-ivf
# VECTOR_STORE=auto
# VECTOR_IVF_NLIST=64
# VECTOR_IVF_NPROBE=8

# ---------- 查询扩展 ----------
# off 关闭 / auto 有 Key 才用 / llm 强制用；扩展失败自动回退原问题
# QUERY_EXPANSION=auto

# ---------- 多实例共享状态（可选）----------
# 配置后限流 / 幂等 / 成本切到 Redis；不可用时自动回退进程内状态
# REDIS_URL=redis://:password@127.0.0.1:6379/0
# REDIS_TIMEOUT_S=1.5
# REDIS_PREFIX=rag

# ---------- 知识库版本与审批 ----------
# KB_STORE=on；off 退回单目录模式（仅测试/批处理）
# KB_DIR=data/kb
# KB_SEED_DIR=data/knowledge
# auto = 本机管理员直通、其他来源审批；on = 全部审批；off = 全部直通
# KB_APPROVAL=auto
# on = 上传/审批后立即返回，索引在后台构建；off = 同步重建
# KB_ASYNC_RELOAD=on
# 保留最近 N 个版本（0=不清理）；活动版本与待审批基线永不删除
# KB_KEEP_VERSIONS=30

# ---------- 对外接口鉴权 ----------
# 格式 名字:密钥，逗号分隔；不写名字时用密钥哈希前 6 位。
# 配置后 /api/ask 与 /api/ask/stream 需要 Authorization: Bearer <key> 或 X-API-Key
# API_KEYS=web:sk_live_xxx,ci:sk_test_yyy

# ---------- 日志与成本 ----------
# file / stdout / both；stdout 每行一个 JSON，供 Fluent Bit / Vector 采集
# LOG_SINK=file
# 单个 JSONL 超过此大小即轮转（0=关闭），保留份数 1-9
# LOG_MAX_BYTES=16777216
# LOG_KEEP=3
# 每千 token 单价（按供应商当期价格页填写）；0 = 只统计 token，不算金额
# TOKEN_PRICE_PER_1K=0
# 汇报页数据缓存秒数（0=关闭）；trace 指标最多延迟这么久
# REPORT_CACHE_TTL=60

# ---------- 生产防护 ----------
# 限流：按客户端 IP 的令牌桶
# RATE_LIMIT_RPS=5
# RATE_LIMIT_BURST=10
# 幂等：Idempotency-Key 的复用窗口（秒）
# IDEMPOTENCY_TTL_S=300
# 成本上限：每日 token 预算，超限后跳过模型调用、降级为抽取式
# DAILY_TOKEN_BUDGET=200000
# 灰度：按请求 key 稳定分流；模型名由 /api/admin/config 动态调整
# CANARY_PERCENT=0
# CANARY_MODEL=
# 管理接口令牌：设置后 /api/admin/* 需带 X-Admin-Token
# ADMIN_TOKEN=

# ---------- PDF 解析 ----------
# auto = 有 pypdf 就用、没有就用内置解析（默认）；builtin = 强制纯标准库；pypdf = 强制用 pypdf
# PDF_ENGINE=auto

# ---------------------------------------------------------------------------
# 智能体笔记（src/notes，v1.10.0）
# ---------------------------------------------------------------------------
# 笔记根目录；不设则用 ~/agent-notes
# NOTE_HOME=~/agent-notes
# 是否把对话原文写进「原文」段（默认关，命令行可用 --keep-raw 临时打开）
# NOTE_KEEP_RAW=off
# 摘要引擎：rule = 纯规则（默认，不联网）；llm / auto 为下一里程碑
# NOTE_DIGEST=rule
# 浏览器跨域：默认关闭；NOTES_CORS=* 或 https://a.com,https://b.com 才放行（个人笔记别随便开）
# NOTES_CORS=
